{
  "name": "edit_config_gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "gen:schema-paths": "node scripts/gen-schema-paths.mjs",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "build:dist": "tauri build && node scripts/copy-dist.mjs"
  },
  "//": "build:dist 依赖的 scripts/copy-dist.mjs 在 Task 21 创建；Task 1 阶段只用 dev/build/test/check/build:tauri",
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.2",
    "jsdom": "30.1.3",
    "pinyin-pro": "3.29.5",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
